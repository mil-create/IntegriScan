  }

  Widget _buildCalendarSkeleton(
      Color baseColor, Color highlightColor, double radius, BuildContext context) {
    return AspectRatio(
      aspectRatio: 1,
      child: Container(
        decoration: BoxDecoration(
          color: Theme.of(context).scaffoldBackgroundColor,
