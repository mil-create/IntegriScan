                      if (logsForSelectedDay.isNotEmpty) {
                        _showScanPhotoPreviewDialog(context, logsForSelectedDay, colors);
                      }
                    },
                    onPageChanged: (focusedDay) {
                      _focusedDay = focusedDay;
                    },
