  final AppColors colors;
  final String label;
  final bool selected;
  final VoidCallback onTap;
  final String? tooltipMessage; // Optional tooltip for symptom description

  const SymptomChip({
    super.key,
    required this.colors,
    required this.label,
    required this.selected,
    required this.onTap,
    this.tooltipMessage,
  });

  @override
  Widget build(BuildContext context) {
