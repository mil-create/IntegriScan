                      const SizedBox(height: AppSpacing.xs / 2),
                      Text(
                        log.bodyArea.split(' ')[0], // Just first part for brevity
                        style: TextStyle(
                          fontSize: AppSpacing.sm * 0.75, // 9 ≈ 12*0.75
                          fontWeight: FontWeight.w600,
                          color: colors.textPrimary,
