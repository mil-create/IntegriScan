  ThemeExtension<AppColors> copyWith({
    Color? background,
    Color? surface,
    Color? textPrimary,
    Color? textSecondary,
    Color? accent,
    Color? accentSoft,
    Color? border,
    Color? success,
    Color? warning,
    Color? danger,
  }) {
